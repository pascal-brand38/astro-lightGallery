import type { AstroLightGalleryImgType } from '../index';
import '../css/adaptive.css';

type Props = {
  img: AstroLightGalleryImgType,
  class?: string;
};

const {
  class: className,
  img,
} = Astro.props;

const height = '45vw';
const maxHeight = '325px';

---

<a
  class:list={[className]}
  href={img.src}
  data-sub-html={img.subHtml ? img.subHtml : ''}
>
  <img
    src={img?.srcThumb ?? img.src}
    alt={img?.alt ?? ''}
    loading={img.loading ?? 'lazy'}
  />
</a>

<style define:vars={{height, maxHeight}}>
.astro-lightgallery-google-photos-item {
  flex-grow: 1;
  margin: 2px;
  width: auto;
}

.astro-lightgallery-google-photos-item img {
  height: var(--height);
  max-height: var(--maxHeight);
  object-fit: cover;
  vertical-align: bottom;
  width: 100%;
}
</style>

