import 'lightgallery/css/lightgallery-bundle.css';
import 'astro-lightgallery/css/adaptive.css';

import type { AstroLightGalleryType } from '../index';

type Props = AstroLightGalleryType;

const {
  options = {}, // https://www.lightgalleryjs.com/docs/settings/
  addPlugins = [],
  id = `astro-lightgallery-${Math.random().toString(36).slice(2, 11)}`,
  class: className,
  layout,
  ...props
} = Astro.props;

const paramLayout = layout ? (({ imgs, ...o }) => o)(layout) : {}; // remove imgs from layout

const classContainer = layout?.classContainer ?? null;
const classItem = layout?.classItem ?? null;
---

<!-- slot is provided, that means that the user is using his gallery layout
     only provide lightgallery setup
  -->{
  Astro.slots.has('default') && (
    <astro-lightgallery
      id={id}
      class={className}
      {...props}
      data-options={JSON.stringify(options)}
      data-id={id}
      data-addplugins={JSON.stringify(addPlugins)}
      data-param-layout={JSON.stringify(paramLayout)}
    >
      <slot />
    </astro-lightgallery>
  )
}

<!-- slot is not provided, that means that the user is using the gallery layout of astro-gallery
     the description of this layout is provided in layout, including the images
  -->

{
  !Astro.slots.has('default') && layout !== undefined && (
    <astro-lightgallery
      id={id}
      class:list={['astro-lightgallery-adaptive-container', className, classContainer]}
      {...props}
      data-options={JSON.stringify(options)}
      data-id={id}
      data-addplugins={JSON.stringify(addPlugins)}
      data-param-layout={JSON.stringify(paramLayout)}
    >
      {
        // TODO: use Image from astro if this is possible
        layout.imgs.map((img) => (
          <a
            class:list={['astro-lightgallery-adaptive-item', classItem]}
            href={img.src}
            data-sub-html={img.subHtml ? img.subHtml : ''}
          >
            <img
              src={img?.srcThumb ?? img.src}
              alt={img?.alt ?? ''}
              loading={img.loading ?? 'lazy'}
            />
          </a>
        ))
      }
    </astro-lightgallery>
  )
}

<script>
  import { createLightGallery } from '../index';
  import type { AstroLightGalleryPluginStrType } from '../index';
  import type { LightGallerySettings } from 'lightgallery/lg-settings';
  import type { LightGallery } from 'lightgallery/lightgallery';

  class AstroLightGallery extends HTMLElement {
    /** pointer to the lightgallery structure that was created using "new",
     *  even when not initialized */
    astroLightGallery: Promise<LightGallery | undefined> | undefined;

    constructor() {
      super();
      this.astroLightGallery = undefined;

      try {
        // Parse data attributes with fallbacks and validation
        const options: LightGallerySettings = this.parseDataAttribute('options', {});
        const id = this.dataset.id;
        const addPlugins: AstroLightGalleryPluginStrType[] = this.parseDataAttribute(
          'addplugins',
          [],
        );
        const paramLayout = this.parseDataAttribute('paramLayout', {});

        if (!id) {
          console.error('AstroLightGallery: Missing required id attribute');
          return;
        }

        this.astroLightGallery = createLightGallery(id, options, addPlugins);

        this.setZoomProperty(id, paramLayout);
      } catch (error) {
        console.error('AstroLightGallery initialization failed:', error);
      }
    }

    // method to reduce duplication
    private parseDataAttribute<T>(attributeName: string, fallback: T): T {
      try {
        const value = this.dataset[attributeName];
        return value ? JSON.parse(value) : fallback;
      } catch (error) {
        console.warn(`AstroLightGallery: Failed to parse ${attributeName}, using fallback:`, error);
        return fallback;
      }
    }

    private setZoomProperty(id: string, paramLayout: any): void {
      const element = document.querySelector<HTMLElement>(`#${id}`);
      if (!element) {
        console.warn(`AstroLightGallery: Element with id "${id}" not found`);
        return;
      }

      const zoom = (paramLayout?.adaptive?.zoom ?? 100).toString();
      element.style.setProperty('--zoom', zoom);
    }
  }

  // Register custom element if not already defined
  if (!customElements.get('astro-lightgallery')) {
    customElements.define('astro-lightgallery', AstroLightGallery);
  }
</script>
