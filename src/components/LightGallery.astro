import 'lightgallery/css/lightgallery-bundle.css';

import type { AstroLightGalleryType } from '../index';
import LightGalleryItem from './LightGalleryItem.astro';
type Props = AstroLightGalleryType;

const {
  options = {}, // https://www.lightgalleryjs.com/docs/settings/
  addPlugins = [],
  id = `astro-lightgallery-id-${Math.random().toString(36).slice(2, 11)}`,
  class: className,
  layout,
  ...props
} = Astro.props;

const paramLayout = layout ? (({ imgs, ...o }) => o)(layout) : {}; // remove imgs from layout

const layoutType = (layout ? (layout.type ?? 'adaptive') : null);

const useSlot = Astro.slots.has('default') || !layout;
if (!useSlot && !layoutType) {
  console.warn(
    'AstroLightGallery: Neither layout nor slot available. To remove this warning, provide a layout or use a slot.',
  );
}
if (useSlot && layoutType) {
  console.warn(
    'AstroLightGallery: Both layout and slot are provided. Only one should be used. Slot is used.To remove this warning, provide either a layout or use a slot.',
  );
}

const layoutClassContainer = layoutType ? `astro-lightgallery-${layoutType}-container` : null;
const layoutClassItem = layoutType ? `astro-lightgallery-${layoutType}-item` : null;
const classContainer = layout?.classContainer ?? null;
const classItem = layout?.classItem ?? null;

// google photos css style variables with fallbacks
const googlePhotosHeight = layout?.googlePhotos?.height ?? '45vw';
const googlePhotosMaxHeight = layout?.googlePhotos?.maxHeight ?? googlePhotosHeight;

---

<astro-lightgallery
  id={id}
  class:list={[layoutClassContainer, className, classContainer]}
  {...props}
  data-options={JSON.stringify(options)}
  data-id={id}
  data-addplugins={JSON.stringify(addPlugins)}
  data-param-layout={JSON.stringify(paramLayout)}
>
  { useSlot && <slot /> }
  { !useSlot &&  layout.imgs.map((img) => <LightGalleryItem img={img} class:list={[layoutClassItem, classItem]} />) }
</astro-lightgallery>

<script>
  import { createLightGallery } from '../index';
  import type { AstroLightGalleryPluginStrType } from '../index';
  import type { LightGallerySettings } from 'lightgallery/lg-settings';
  import type { LightGallery } from 'lightgallery/lightgallery';

  class AstroLightGallery extends HTMLElement {
    /** pointer to the lightgallery structure that was created using "new",
     *  even when not initialized */
    astroLightGallery: Promise<LightGallery | undefined> | undefined;

    constructor() {
      super();
      this.astroLightGallery = undefined;

      try {
        // Parse data attributes with fallbacks and validation
        const options: LightGallerySettings = this.parseDataAttribute('options', {});
        const id = this.dataset.id;
        const addPlugins: AstroLightGalleryPluginStrType[] = this.parseDataAttribute(
          'addplugins',
          [],
        );
        const paramLayout = this.parseDataAttribute('paramLayout', {});

        if (!id) {
          console.error('AstroLightGallery: Missing required id attribute');
          return;
        }

        this.astroLightGallery = createLightGallery(id, options, addPlugins);

        this.setZoomProperty(id, paramLayout);
      } catch (error) {
        console.error('AstroLightGallery initialization failed:', error);
      }
    }

    // method to reduce duplication
    private parseDataAttribute<T>(attributeName: string, fallback: T): T {
      try {
        const value = this.dataset[attributeName];
        return value ? JSON.parse(value) : fallback;
      } catch (error) {
        console.warn(`AstroLightGallery: Failed to parse ${attributeName}, using fallback:`, error);
        return fallback;
      }
    }

    private setZoomProperty(id: string, paramLayout: any): void {
      const element = document.querySelector<HTMLElement>(`#${id}`);
      if (!element) {
        console.warn(`AstroLightGallery: Element with id "${id}" not found`);
        return;
      }

      const zoom = (paramLayout?.adaptive?.zoom ?? 100).toString();
      element.style.setProperty('--zoom', zoom);
    }
  }

  // Register custom element if not already defined
  if (!customElements.get('astro-lightgallery')) {
    customElements.define('astro-lightgallery', AstroLightGallery);
  }
</script>

<style define:vars={{ googlePhotosHeight, googlePhotosMaxHeight }} is:global>
[id^="astro-lightgallery-id-"].astro-lightgallery-google-photos-container {
  display: flex;
  flex-wrap: wrap;
  flex-basis: 0;
}

[id^="astro-lightgallery-id-"].astro-lightgallery-google-photos-container .astro-lightgallery-google-photos-item {
  flex-grow: 1;
  margin: 2px;
  width: auto;
}

[id^="astro-lightgallery-id-"].astro-lightgallery-google-photos-container .astro-lightgallery-google-photos-item img {
  height: var(--googlePhotosHeight);
  max-height: var(--googlePhotosMaxHeight);
  object-fit: cover;
  vertical-align: bottom;
  width: 100%;
}
</style>

<script is:inline define:vars={{layout, id, layoutClassItem}}>
  if (layout?.type === 'google-photos') {
    let breakpoints = layout.googlePhotos?.breakpoints;
    if (!layout.googlePhotos) {
      // default breakpoint for google photos layout if height and maxHeight are not provided
      breakpoints = { 601: { height: '20vw', maxHeight: '205px' } };
    }
    if (breakpoints) {
      let style = document.createElement('style');
      style.innerHTML = '';
      for (const [breakpoint, values] of Object.entries(breakpoints)) {
        style.innerHTML +=
          `@media (min-width: ${breakpoint}px) {` +
          `  #${id}.astro-lightgallery-google-photos-container .astro-lightgallery-google-photos-item img {` +
          `    height: ${values.height};` +
          `    max-height: ${values.maxHeight};` +
          `  }` +
          `}`;
      }
      document.head.appendChild(style);
    }
  }
</script>
